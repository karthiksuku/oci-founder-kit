# Copy to an ignored local .tfvars file; never commit real targets.
tenancy_ocid        = "ocid1.tenancy.oc1..<expected-tenancy>"
compartment_ocid    = "ocid1.compartment.oc1..<workload-compartment>"
region              = "<workload-region>"
config_file_profile = "DEFAULT"
auth                = "APIKey"
name                = "taskboard"
# After the empty repository is created, change to true and review a new plan.
# Image publication refuses the repository until that update is applied.
immutable_tags      = false
