# Merge these non-secret inputs into a private copy of terraform.tfvars.example.
# Existing secret values, certificate private keys and client credentials never go here.
production = {
  public_origin             = "https://app.example.com"
  oidc_issuer               = "https://identity.example.com"
  oidc_client_id            = "<registered-oidc-client-id>"
  certificate_ocid          = "ocid1.certificate.oc1..<managed-certificate>"
  security_compartment_ocid = "ocid1.compartment.oc1..<security-compartment>"
  database_secret_ocid      = "ocid1.vaultsecret.oc1..<database-password>"
  database_secret_version   = 1
  oidc_client_secret_ocid   = "ocid1.vaultsecret.oc1..<oidc-client-secret>"
  session_secret_ocid       = "ocid1.vaultsecret.oc1..<session-signing-secret>"
}
app_image = "<region-key>.ocir.io/<namespace>/taskboard@sha256:<verified-image-digest>"
