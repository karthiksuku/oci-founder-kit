---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { checkpoint, createPrompt, defaultSelection, installCommand, repository, resumePrompt, tasks } from '../lib/prompt';

const doc = (path: string) => `${repository}/blob/main/${path}`;
const initialPrompt = createPrompt({ task: 'build', agent: 'codex', stack: 'existing', brief: '' });
const initialCheckpoint = checkpoint(defaultSelection);
const guides = [
  { title: 'Installation & updates', text: 'Add the kit to your project without replacing your existing skills.', path: 'docs/INSTALL.md', icon: 'terminal' },
  { title: 'Credentials & compartments', text: 'Prepare access, choose your target and understand administrator steps.', path: 'docs/START-HERE.md#oci-credentials-and-initial-setup', icon: 'shield' },
  { title: 'Well-Architected review', text: 'Make decisions across security, resilience, cost, operations and distributed cloud.', path: 'skills/oci-foundation/references/well-architected.md', icon: 'layers' },
  { title: 'Migration playbook', text: 'Discover dependencies, adapt your code, rehearse data moves and plan rollback.', path: 'skills/oci-migrate-web/references/migration.md', icon: 'migrate' },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Build your next app on Oracle Cloud Infrastructure with Claude Code or Codex. Get a tailored starting prompt, set up OCI, or migrate an existing application." />
    <meta name="theme-color" content="#121715" />
    <meta property="og:title" content="OCI Founder Kit — From idea to your first app" />
    <meta property="og:description" content="Your idea. Your code. Your cloud. A practical open-source starting point for building on OCI with Claude Code or Codex." />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>OCI Founder Kit — From idea to your first app</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('oci-founder-theme');
        const theme = saved === 'light' || saved === 'dark' ? saved : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="#" aria-label="OCI Founder Kit home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span>OCI <strong>Founder Kit</strong></span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#build">Build</a><a href="#migrate">Migrate</a><a href="#setup">Set up OCI</a><a href="#examples">Examples</a><a href="#guides">Guides</a>
        </nav>
        <div class="header-actions">
          <button class="icon-button theme-toggle" type="button" aria-label="Switch to light theme"><Icon name="sun" class="sun-icon" /><Icon name="moon" class="moon-icon" /></button>
          <a class="header-github" href={repository} aria-label="View OCI Founder Kit on GitHub"><Icon name="code" size={18} /><span>GitHub</span><Icon name="diagonal" size={13} /></a>
          <button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation"><Icon name="menu" /></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav shell" aria-label="Mobile navigation" hidden>
        <a href="#build">Build an app</a><a href="#migrate">Migrate an app</a><a href="#setup">Set up OCI</a><a href="#examples">Examples</a><a href="#guides">Guides</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero shell" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <a class="eyebrow hero-badge" href="#evidence"><span class="status-dot" aria-hidden="true"></span> OPEN SOURCE. BUILT FOR BUILDERS. <Icon name="arrow" size={14} /></a>
          <h1 id="hero-heading">From idea to<br />your first app<br /><span>on OCI.</span></h1>
          <p class="hero-description">Bring your idea. Build with Claude Code or Codex. Get a clear path from your first local version to a reviewed cloud deployment.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#start" data-task-link="build">Start building <Icon name="arrow" size={19} /></a>
            <a class="button button-secondary" href="#start" data-task-link="migrate">Migrate my app <Icon name="migrate" size={19} /></a>
          </div>
          <p class="hero-caption"><span>YOUR CODE.</span><span>YOUR ACCOUNT.</span><span>YOUR CALL.</span></p>
        </div>
        <div class="hero-art" aria-label="Workflow: describe your app, build and test locally, review the plan, then approve deployment to your OCI account">
          <div class="orbit-line orbit-line-one" aria-hidden="true"></div>
          <div class="orbit-line orbit-line-two" aria-hidden="true"></div>
          <span class="art-coordinate coordinate-top" aria-hidden="true">IDEA → EXECUTION</span>
          <div class="launch-window">
            <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>your-next-thing /</span><Icon name="code" size={15} /></div>
            <div class="window-body">
              <div class="window-label"><span class="tiny-square" aria-hidden="true"></span> A WORKFLOW IN YOUR WORKSPACE</div>
              <div class="prompt-snippet"><span class="prompt-glyph" aria-hidden="true">›</span><p>“Let’s turn this idea<br />into something <em>real.</em>”</p></div>
              <div class="workflow-stages">
                <div class="workflow-stage"><span class="stage-number">01</span><div><strong>Build & test</strong><span>Your app, running locally</span></div><span class="stage-tag">LOCAL</span></div>
                <div class="workflow-stage"><span class="stage-number">02</span><div><strong>Review the plan</strong><span>Access, architecture & cost</span></div><Icon name="shield" size={18} /></div>
                <div class="workflow-stage"><span class="stage-number">03</span><div><strong>Approve & deploy</strong><span>Your OCI account</span></div><Icon name="cloud" size={18} /></div>
              </div>
            </div>
            <div class="window-footer"><span>Claude Code <span class="separator">/</span> Codex</span><span>you’re in control <span aria-hidden="true">↗</span></span></div>
          </div>
          <div class="floating-note"><Icon name="layers" size={19} /><span>Big idea.<br /><strong>Practical first step.</strong></span></div>
          <span class="art-coordinate coordinate-bottom" aria-hidden="true">BUILD SOMETHING THAT MATTERS.</span>
        </div>
      </section>

      <div class="principles-bar">
        <div class="shell principles-inner"><p><Icon name="code" size={18} /> Works in your existing project</p><p><Icon name="terminal" size={18} /> Start locally, connect OCI later</p><p><Icon name="shield" size={18} /> You approve cloud changes</p></div>
      </div>

      <section class="section shell start-section" id="start" aria-labelledby="start-heading">
        <div class="section-heading"><div><p class="eyebrow">01 / YOUR STARTING POINT</p><h2 id="start-heading">What are we building?</h2></div><p>A little context goes a long way.<br />Make a prompt. Open your agent. Start.</p></div>
        <div class="builder">
          <form id="prompt-form" class="builder-form" autocomplete="off">
            <fieldset class="task-choices"><legend>I want to</legend><div class="task-options">
              <label><input type="radio" name="task" value="build" checked /><span><Icon name="code" size={18} /> Build</span></label>
              <label><input type="radio" name="task" value="migrate" /><span><Icon name="migrate" size={18} /> Migrate</span></label>
              <label><input type="radio" name="task" value="setup" /><span><Icon name="shield" size={18} /> Set up OCI</span></label>
            </div></fieldset>
            <fieldset class="agent-choices"><legend>My coding agent</legend><div class="agent-options">
              <label><input type="radio" name="agent" value="codex" checked /><span><span class="agent-symbol" aria-hidden="true">&gt;_</span>Codex</span></label>
              <label><input type="radio" name="agent" value="claude" /><span><span class="agent-symbol claude-symbol" aria-hidden="true">✳</span>Claude Code</span></label>
            </div></fieldset>
            <div class="field" id="stack-field"><label for="stack">My starting point</label><select id="stack" name="stack" aria-describedby="stack-help"><option value="existing">Keep my existing stack</option><option value="nextjs">Next.js + TypeScript</option><option value="fastapi">Python + FastAPI</option><option value="choose">Help me choose</option><option value="taskboard" id="taskboard-option">Create an editable Taskboard</option></select><p id="stack-help" class="field-help">Keep what works, choose a new stack, or start from the included Node.js/PostgreSQL app.</p></div>
            <div class="field"><label for="brief">The idea <span class="optional">optional</span></label><textarea id="brief" name="brief" rows="3" maxlength="1200" placeholder={tasks.build.example} aria-describedby="brief-help brief-count"></textarea><div class="field-meta"><p id="brief-help">A few sentences about who it’s for and what it should do. Keep credentials out.</p><span id="brief-count">0 / 1200</span></div></div>
            <p class="local-note"><Icon name="shield" size={14} /> Your brief stays on this page and clears on reload.</p>
            <noscript><p class="notice">Enable JavaScript to tailor the prompt, or copy the default build prompt and edit it in your agent. The guides below work without JavaScript.</p></noscript>
          </form>
          <div class="builder-output">
            <div class="output-header"><span><span class="status-dot" aria-hidden="true"></span> YOUR FIRST PROMPT</span><span id="prompt-agent-label">CODEX</span></div>
            <label class="sr-only" for="generated-prompt">Generated prompt to paste into your coding agent</label>
            <textarea id="generated-prompt" readonly spellcheck="false">{initialPrompt}</textarea>
            <div class="output-actions"><span class="prompt-hint">Ready when you are.</span><button id="copy-prompt" class="button button-primary" type="button"><Icon name="copy" size={17} /><span>Copy prompt</span></button></div>
            <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
          </div>
        </div>
        <section class="handoff" aria-labelledby="handoff-heading">
          <div class="handoff-heading"><div><p class="eyebrow">FROM PROMPT TO PROGRESS</p><h3 id="handoff-heading">Know what comes next.</h3></div><span class="handoff-path" id="handoff-path">Build an app · Codex</span></div>
          <div class="handoff-grid">
            <div class="handoff-step"><span class="next-label">01 / OPEN YOUR PROJECT</span><p id="next-step-text">{tasks.build.next}</p><a class="text-link" href={doc('docs/INSTALL.md')}>Installation guide <Icon name="diagonal" size={14} /></a></div>
            <div class="handoff-step"><span class="next-label">02 / YOUR FIRST CHECKPOINT</span><h4 id="checkpoint-title">{initialCheckpoint.title}</h4><ul id="checkpoint-results">{initialCheckpoint.results.map(result => <li>{result}</li>)}</ul><a class="text-link" id="checkpoint-guide" href={doc(initialCheckpoint.guide)}><span>{initialCheckpoint.guideLabel}</span><Icon name="diagonal" size={14} /></a></div>
          </div>
          <p class="handoff-note">Expected outputs, not completed checks. Record actual results in your project’s <a href={doc('docs/PROGRESS.md')}>progress record</a>.</p>
          <details class="resume-details" id="resume-details"><summary><span><span class="next-label">03 / PICK UP WHERE YOU LEFT OFF</span><strong>Continue in your next agent session</strong></span><span class="details-indicator" aria-hidden="true">+</span></summary><div class="resume-content"><p>Open the same app folder and paste this. Your agent reads the project’s progress record before continuing.</p><label class="sr-only" for="resume-prompt">Resume prompt to continue in your coding agent</label><textarea id="resume-prompt" readonly spellcheck="false">{resumePrompt(defaultSelection)}</textarea><div class="output-actions"><p>Bookmark this page to keep your task, agent and stack choices. Your brief is not saved.</p><button class="button button-secondary" type="button" id="copy-resume"><Icon name="copy" size={17} />Copy resume prompt</button></div><p id="resume-status" class="copy-status" role="status" aria-live="polite"></p></div></details>
          <p class="sr-only" id="selection-status" role="status" aria-live="polite"></p>
        </section>
        <details class="terminal-details"><summary><span><Icon name="terminal" size={19} /> Prefer the terminal?</span><span class="details-indicator" aria-hidden="true">+</span></summary><div class="terminal-content"><p id="install-help">Requires Git, Python 3.11+ and your installed coding agent. For a first installation, create your app folder first, then run these commands from outside it. Replace the example path with your app’s absolute path. If the kit is already installed, use the resume prompt above.</p><pre><code id="install-command">{installCommand('codex')}</code></pre><button type="button" class="text-button" id="copy-install"><Icon name="copy" size={15} />Copy install commands</button><span id="install-status" class="inline-status" role="status"></span><div id="taskboard-preview" hidden><p>Creation is offline and does not start the app. With Docker and Compose running, start the local sandbox from your new project:</p><pre><code>python3 local_preview.py start</code></pre><p>Open the URL it prints. Stop with <code>python3 local_preview.py stop</code>; your tasks are retained. <a href={doc('blueprints/fullstack-container/LOCAL.md')}>Check preview requirements and troubleshooting →</a></p></div><p class="terminal-footnote">Then start your agent in the app folder and use <code id="agent-entry">$oci-kit</code>. <a href={doc('docs/INSTALL.md#claude-code-plugin-alternative')}>Claude plugin option →</a></p></div></details>
      </section>

      <section class="paths-section section" aria-labelledby="paths-heading">
        <div class="shell"><div class="section-heading"><div><p class="eyebrow">02 / PICK YOUR PATH</p><h2 id="paths-heading">A real next step.<br />Wherever you’re starting.</h2></div><p>One toolkit, three entry points.<br />Follow the path that fits your project.</p></div>
          <div class="path-grid">
            <article class="path-card" id="build"><div class="path-top"><span class="path-icon"><Icon name="code" size={24} /></span><span class="mono-label">01 — BUILD</span></div><h3>Start with an idea.<br />Leave with working code.</h3><p>Define the smallest useful app. Build it in your own project, test it locally, then prepare an OCI deployment that fits.</p><ul><li>A clear brief and a focused first version</li><li>Your framework, data and identity choices</li><li>Tests before cloud infrastructure</li></ul><a class="path-link" href="#start" data-task-link="build">Build something <Icon name="arrow" /></a><a class="subtle-link" href={doc('skills/oci-build/references/app-workflow.md')}>Read the build workflow <Icon name="diagonal" size={13} /></a></article>
            <article class="path-card" id="migrate"><div class="path-top"><span class="path-icon"><Icon name="migrate" size={24} /></span><span class="mono-label">02 — MIGRATE</span></div><h3>Keep the app.<br />Find its path to OCI.</h3><p>Bring your Vercel or Netlify app. Map platform dependencies, adapt the code and test the target before switching traffic.</p><ul><li>Read-only discovery comes first</li><li>Retain services you want to keep</li><li>Staging, data checks and rollback</li></ul><a class="path-link" href="#start" data-task-link="migrate">Map my migration <Icon name="arrow" /></a><a class="subtle-link" href={doc('docs/START-HERE.md#existing-vercel-or-netlify-application')}>Read the migration guide <Icon name="diagonal" size={13} /></a></article>
            <article class="path-card" id="setup"><div class="path-top"><span class="path-icon"><Icon name="shield" size={24} /></span><span class="mono-label">03 — SET UP</span></div><h3>Make room<br />for your next thing.</h3><p>Understand the account steps, configure local access and prepare a dedicated compartment with permissions you can review.</p><ul><li>Credentials stay in your environment</li><li>Scoped compartment and IAM plans</li><li>Well-Architected decisions and costs</li></ul><a class="path-link" href="#start" data-task-link="setup">Prepare my foundation <Icon name="arrow" /></a><a class="subtle-link" href={doc('docs/START-HERE.md#oci-credentials-and-initial-setup')}>Read the setup guide <Icon name="diagonal" size={13} /></a></article>
          </div>
        </div>
      </section>

      <section class="section shell journey-section" aria-labelledby="journey-heading">
        <div class="journey-intro"><p class="eyebrow">03 / KEEP THE MOMENTUM</p><h2 id="journey-heading">Your idea moves forward.<br /><span class="muted">You stay in control.</span></h2><p>The agent helps with the work. You make the decisions. Every stage has a concrete result and a visible next step.</p><a class="text-link" href={doc('docs/PLAYBOOK.md')}>Explore example prompts <Icon name="arrow" size={17} /></a></div>
        <ol class="journey-list"><li><span>01</span><div><h3>Shape it</h3><p>Agree who it’s for, what matters and the smallest version worth building.</p></div></li><li><span>02</span><div><h3>Make it work locally</h3><p>Implement the app, test behavior and preserve what already works.</p></div></li><li><span>03</span><div><h3>Review the cloud plan</h3><p>Understand the target, permissions, resources and dated cost estimate.</p></div></li><li><span>04</span><div><h3>Approve, verify, hand over</h3><p>Approve the exact change. Check the result and keep update, recovery and teardown instructions.</p></div></li></ol>
      </section>

      <section class="section examples-section" id="examples" aria-labelledby="examples-heading"><div class="shell">
        <div class="section-heading"><div><p class="eyebrow">04 / START WITH SOMETHING REAL</p><h2 id="examples-heading">Less blank page.<br />More possibility.</h2></div><p>Explore working patterns and public projects.<br />Choose what fits. Review before you reuse.</p></div>
        <div class="example-grid">
          <article class="example-card"><div class="example-art taskboard-art" aria-hidden="true"><div class="mini-board"><div class="mini-board-heading"><span class="mini-mark"></span><span>Project space</span><span>•••</span></div><div class="mini-columns"><div><i></i><b></b><b></b></div><div><i></i><b></b></div><div><i></i><b></b><b></b></div></div></div><span class="art-label">THE CONTAINER REFERENCE</span></div><div class="example-content"><span class="example-tag">INCLUDED · SANDBOX REFERENCE</span><h3>Full-stack taskboard</h3><p>Create an editable Node.js/PostgreSQL project with agent skills. Run it locally with Docker, then make it your own.</p><div class="stack-tags"><span>Node.js</span><span>PostgreSQL</span><span>Terraform</span></div><p class="example-evidence">Local behavior and read-only plans exercised. Live deployment and production controls require validation.</p><div class="example-footer"><a href={doc('docs/INSTALL.md#create-a-new-editable-starter')} data-task-link="build" data-stack-link="taskboard">Create my Taskboard <Icon name="arrow" size={15} /></a><a href={doc('blueprints/fullstack-container/LOCAL.md')}>Preview guide <Icon name="diagonal" size={15} /></a><a href={doc('LICENSE')}>UPL-1.0</a></div></div></article>
          <article class="example-card"><div class="example-art migration-art" aria-hidden="true"><span class="migration-node">N<span>Next.js server</span></span><div class="migration-track"><i></i><Icon name="arrow" size={26} /><i></i></div><span class="migration-node target-node"><Icon name="cloud" size={35} /><span>Standalone</span></span><span class="art-label">TRY THE LOCAL PACKAGING REHEARSAL</span></div><div class="example-content"><span class="example-tag">INCLUDED · RUNNABLE LOCAL EXAMPLE</span><h3>Rehearse a Next.js move.</h3><p>Compare a normal Next.js production server with its standalone build using the same local HTTP checks.</p><div class="stack-tags"><span>Next.js</span><span>Standalone</span><span>HTTP checks</span></div><p class="example-evidence">Stateless local packaging rehearsal. It does not establish Vercel-hosted behavior, OCI deployment or data and identity migration.</p><div class="example-footer"><a href={doc('examples/migrate-nextjs/README.md')}>Run the rehearsal <Icon name="diagonal" size={15} /></a><a href={doc('examples/migrate-vercel/README.md')}>Assessment fixture <Icon name="diagonal" size={15} /></a><a href={doc('LICENSE')}>UPL-1.0</a></div></div></article>
        </div>
        <div class="community-row"><div><span class="eyebrow">FROM THE COMMUNITY</span><h3>Good ideas are worth building on.</h3><p>Public source references. OCI compatibility still needs review.</p></div><div class="community-links"><a href="https://github.com/fastapi/full-stack-fastapi-template"><span>Full Stack FastAPI Template<small>Python · React · PostgreSQL</small></span><Icon name="diagonal" size={18} /></a><a href="https://github.com/wasp-lang/open-saas"><span>Open SaaS<small>React · Wasp · Prisma</small></span><Icon name="diagonal" size={18} /></a><a href="https://github.com/oracle-devrel/oci-starter"><span>OCI Starter<small>Oracle Cloud project generator</small></span><Icon name="diagonal" size={18} /></a></div></div>
        <p class="source-note">Community links are source references, not bundled dependencies or verified deployments. Check each project’s license and current requirements. <a href={doc('docs/ECOSYSTEM.md')}>View source notes →</a></p>
      </div></section>

      <section class="section shell guides-section" id="guides" aria-labelledby="guides-heading"><div class="section-heading"><div><p class="eyebrow">05 / WHEN YOU NEED THE DETAILS</p><h2 id="guides-heading">A guide for the next question.</h2></div><a class="text-link" href={doc('docs/START-HERE.md')}>Browse the start guide <Icon name="arrow" size={17} /></a></div><div class="guide-grid">{guides.map(guide => <a class="guide-card" href={doc(guide.path)}><Icon name={guide.icon} size={23} /><h3>{guide.title}</h3><p>{guide.text}</p><Icon name="diagonal" size={17} class="guide-arrow" /></a>)}</div><nav class="guide-shortcuts" aria-label="More practical guides"><span>KEEP GOING</span><a href={doc('docs/PROJECT-BRIEF.md')}>Project brief <Icon name="diagonal" size={12} /></a><a href={doc('docs/PROGRESS.md')}>Progress checklist <Icon name="diagonal" size={12} /></a><a href={doc('docs/OPERATIONS.md')}>Troubleshooting <Icon name="diagonal" size={12} /></a><a href={doc('docs/HOOKS.md')}>Optional hooks <Icon name="diagonal" size={12} /></a><a href={doc('docs/STARTER-PATTERNS.md')}>Starter patterns <Icon name="diagonal" size={12} /></a></nav></section>

      <section class="shell evidence-section" id="evidence" aria-labelledby="evidence-heading"><div><p class="eyebrow">OPEN SOURCE. CLEAR ABOUT THE EVIDENCE.</p><h2 id="evidence-heading">Built to be useful.<br />Honest about what’s verified.</h2><p>This is a public preview. Local builds, agent workflows and read-only OCI plans have been exercised. A production launch needs workload-specific deployment, identity, HTTPS, recovery and cutover checks.</p></div><div class="evidence-links"><a href={doc('docs/ROADMAP.md')}>Capabilities & evidence <Icon name="arrow" size={18} /></a><a href={doc('SECURITY.md')}>Security & approval model <Icon name="arrow" size={18} /></a><a href={doc('CONTRIBUTING.md')}>Help make the kit better <Icon name="arrow" size={18} /></a></div></section>

      <section class="shell final-cta"><div><p class="eyebrow">THE NEXT STEP IS YOURS</p><h2>Have an idea?<br /><span>Give it a first commit.</span></h2></div><a class="button button-primary" href="#start" data-task-link="build">Let’s start building <Icon name="arrow" size={21} /></a></section>
    </main>

    <footer class="site-footer shell"><div class="footer-top"><a class="wordmark" href="#"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>OCI <strong>Founder Kit</strong></span></a><nav aria-label="Footer navigation"><a href={repository}>GitHub</a><a href={doc('docs/INSTALL.md')}>Install</a><a href={doc('LICENSE')}>License</a><a href={doc('CONTRIBUTING.md')}>Contribute</a></nav></div><div class="footer-bottom"><p>Independent open-source project by Karthik Sukumar.<br />Not an Oracle product or endorsement.</p><p>Built for people who build.</p></div></footer>

    <script>
      import { checkpoint, createPrompt, installCommand, normalizeSelection, readFragment, repository, resumePrompt, selectionFragment, tasks, type Selection } from '../lib/prompt';
      const form = document.querySelector<HTMLFormElement>('#prompt-form')!;
      const prompt = document.querySelector<HTMLTextAreaElement>('#generated-prompt')!;
      const resume = document.querySelector<HTMLTextAreaElement>('#resume-prompt')!;
      const brief = document.querySelector<HTMLTextAreaElement>('#brief')!;
      const stack = document.querySelector<HTMLSelectElement>('#stack')!;
      const copyStatus = document.querySelector<HTMLElement>('#copy-status')!;
      const resumeStatus = document.querySelector<HTMLElement>('#resume-status')!;
      const installStatus = document.querySelector<HTMLElement>('#install-status')!;
      const install = document.querySelector<HTMLElement>('#install-command')!;
      const defaultInstallHelp = document.querySelector('#install-help')!.textContent!;
      function selection(): Selection {
        const data = new FormData(form);
        return normalizeSelection({ task: data.get('task'), agent: data.get('agent'), stack: data.get('stack') });
      }
      function updatePrompt(announce = false) {
        const chosen = selection();
        const { task, agent } = chosen;
        stack.value = chosen.stack;
        const taskboard = task === 'build' && chosen.stack === 'taskboard';
        const result = checkpoint(chosen);
        const agentLabel = agent === 'codex' ? 'Codex' : 'Claude Code';
        prompt.value = createPrompt({ ...chosen, brief: brief.value });
        resume.value = resumePrompt(chosen);
        document.querySelector('#next-step-text')!.textContent = taskboard
          ? 'Open your agent in the intended empty project folder, or tell it the new project path. Paste the first prompt to create your editable starter. Keep any existing app intact.'
          : tasks[task].next;
        document.querySelector('#prompt-agent-label')!.textContent = agentLabel.toUpperCase();
        document.querySelector('#handoff-path')!.textContent = `${taskboard ? 'Editable Taskboard' : tasks[task].label} · ${agentLabel}`;
        document.querySelector('#checkpoint-title')!.textContent = result.title;
        document.querySelector('#checkpoint-results')!.replaceChildren(...result.results.map(text => { const item = document.createElement('li'); item.textContent = text; return item; }));
        const guide = document.querySelector<HTMLAnchorElement>('#checkpoint-guide')!;
        guide.href = `${repository}/blob/main/${result.guide}`;
        guide.querySelector('span')!.textContent = result.guideLabel;
        document.querySelector<HTMLElement>('#stack-field')!.hidden = task === 'setup';
        const taskboardOption = document.querySelector<HTMLOptionElement>('#taskboard-option')!;
        taskboardOption.disabled = task !== 'build';
        taskboardOption.hidden = task !== 'build';
        document.querySelector('#stack-help')!.textContent = taskboard
          ? 'Copies an editable app and skills into a new or empty project. Git and Python create it; Docker runs the local preview.'
          : task === 'migrate' ? 'Keep your current stack unless you explicitly choose a change.' : 'Keep what works, choose a new stack, or start from the included Node.js/PostgreSQL app.';
        document.querySelector('#brief-count')!.textContent = `${brief.value.length} / 1200`;
        brief.placeholder = tasks[task].example;
        install.textContent = installCommand(agent, taskboard ? 'taskboard' : 'existing');
        document.querySelector('#install-help')!.textContent = taskboard
          ? 'Requires Git, Python 3.11+ and your coding agent. Run from outside the target project. Replace the example path with a new folder under an existing parent, or an empty existing folder. Existing files are never overwritten. Add --dry-run to preview file creation first.'
          : defaultInstallHelp;
        document.querySelector<HTMLElement>('#taskboard-preview')!.hidden = !taskboard;
        document.querySelector('#agent-entry')!.textContent = agent === 'codex' ? '$oci-kit' : '/oci-kit';
        copyStatus.textContent = '';
        resumeStatus.textContent = '';
        installStatus.textContent = '';
        if (announce) document.querySelector('#selection-status')!.textContent = `${tasks[task].label}, ${agentLabel}. First checkpoint: ${result.title}. Prompts updated.`;
      }
      function writeFragment(anchor: string, replace = false) {
        const hash = selectionFragment(selection(), anchor);
        if (hash !== location.hash) {
          if (replace) history.replaceState(null, '', hash);
          else history.pushState(null, '', hash);
        }
      }
      function scrollToAnchor(anchor: string, focus = false) {
        const target = anchor ? document.getElementById(anchor) : null;
        if (target) {
          if (focus) { target.tabIndex = -1; target.focus({ preventScroll: true }); }
          target.scrollIntoView();
        } else if (!anchor) window.scrollTo({ top: 0 });
      }
      function restoreRoute(scroll = true) {
        const route = readFragment(location.hash);
        form.querySelector<HTMLInputElement>(`input[name="task"][value="${route.selection.task}"]`)!.checked = true;
        form.querySelector<HTMLInputElement>(`input[name="agent"][value="${route.selection.agent}"]`)!.checked = true;
        // Re-enable before restoring a Taskboard choice from history.
        document.querySelector<HTMLOptionElement>('#taskboard-option')!.disabled = false;
        stack.value = route.selection.stack;
        updatePrompt();
        writeFragment(route.anchor, true);
        if (scroll) scrollToAnchor(route.anchor);
      }
      brief.addEventListener('input', () => updatePrompt());
      form.addEventListener('change', event => {
        if (event.target === brief) return;
        updatePrompt(true);
        writeFragment(readFragment(location.hash).anchor || 'start');
      });
      form.addEventListener('submit', event => event.preventDefault());
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[data-task-link]').forEach(link => link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (link.dataset.taskLink) {
          const radio = form.querySelector<HTMLInputElement>(`input[name="task"][value="${link.dataset.taskLink}"]`);
          if (radio) radio.checked = true;
          if (link.dataset.stackLink === 'taskboard') {
            document.querySelector<HTMLOptionElement>('#taskboard-option')!.disabled = false;
            stack.value = 'taskboard';
          }
          updatePrompt(true);
        }
        const anchor = link.dataset.taskLink ? 'start' : readFragment(link.hash).anchor;
        writeFragment(anchor);
        scrollToAnchor(anchor, true);
      }));
      window.addEventListener('popstate', () => restoreRoute());
      window.addEventListener('hashchange', () => restoreRoute());
      restoreRoute(false);
      if (readFragment(location.hash).anchor) requestAnimationFrame(() => scrollToAnchor(readFragment(location.hash).anchor));
      async function copyPrompt(source: HTMLTextAreaElement, status: HTMLElement, message: string) {
        try { await navigator.clipboard.writeText(source.value); status.textContent = message; }
        catch { source.focus(); source.select(); status.textContent = 'Clipboard unavailable. Your prompt is selected — press Ctrl+C or ⌘C to copy.'; }
      }
      document.querySelector('#copy-prompt')!.addEventListener('click', () => copyPrompt(prompt, copyStatus, 'Copied. Paste it into your agent in your project folder.'));
      document.querySelector('#copy-resume')!.addEventListener('click', () => copyPrompt(resume, resumeStatus, 'Copied. Open the same project in your agent and continue from its progress record.'));
      document.querySelector('#copy-install')!.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(install.textContent || ''); installStatus.textContent = 'Commands copied.'; }
        catch { const selection = window.getSelection(); const range = document.createRange(); range.selectNodeContents(install); selection?.removeAllRanges(); selection?.addRange(range); installStatus.textContent = 'Commands selected. Press Ctrl+C or ⌘C to copy.'; }
      });
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      function updateThemeLabel() { themeToggle.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`); }
      updateThemeLabel();
      themeToggle.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = theme; try { localStorage.setItem('oci-founder-theme', theme); } catch {} updateThemeLabel(); });
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const mobileNav = document.querySelector<HTMLElement>('#mobile-nav')!;
      function closeMenu() { mobileNav.hidden = true; menu.setAttribute('aria-expanded', 'false'); menu.setAttribute('aria-label', 'Open navigation'); }
      menu.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') === 'true'; mobileNav.hidden = open; menu.setAttribute('aria-expanded', String(!open)); menu.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation'); });
      mobileNav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && !mobileNav.hidden) { closeMenu(); menu.focus(); } });
    </script>
  </body>
</html>
